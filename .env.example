# =============================================================================
# EventHub - Shared environment template
# =============================================================================
# Copy to .env in each service folder (or use direnv) and fill values.

# --- Shared ---
JWT_SECRET=eventhub_dev_jwt_secret_change_me_32chars
NODE_ENV=development

# --- event-service (port 4101) ---
# Note: 4101/4102 chosen to avoid conflict with GrowAppAI platform
# (which uses 4001 for stage-01 frontend and 6001-6012 for services).
EVENT_SERVICE_PORT=4101
DATABASE_URL=postgresql://eventhub:eventhub_dev@localhost:5440/eventhub_events?schema=public
REDIS_URL=redis://localhost:6390
ATTENDEE_SERVICE_URL=http://localhost:4102

# --- attendee-service (port 4102) ---
ATTENDEE_SERVICE_PORT=4102
MONGODB_URL=mongodb://eventhub:eventhub_dev@localhost:27018/eventhub_attendees?authSource=admin

# --- frontend (port 3100) ---
NEXT_PUBLIC_EVENT_API=http://localhost:4101
NEXT_PUBLIC_ATTENDEE_API=http://localhost:4102
